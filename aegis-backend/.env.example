APP_NAME=fastapi-app
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aegis

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=60

JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_CONFIG_ENCRYPTION_KEY=

API_KEY_PREFIX_LENGTH=8
API_KEY_TOKEN_BYTES=32
API_KEY_CREATE_RATE_LIMIT=5
API_KEY_CREATE_RATE_WINDOW_SECONDS=60
API_KEY_ADMIN_ROLE_NAME=admin

# Comma-separated emails promoted to Admin when they register.
# Leave empty after the initial administrator has been created.
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Aegis Administrator

# Shared only between the Control Plane and reverse proxy. Generate a unique
# random value for each environment; never commit the real value.
INTERNAL_API_TOKEN=
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_SYNC_INTERVAL_SECONDS=2
GRPC_ENABLED=true
AUTO_IP_BLOCK_ENABLED=true
AUTO_IP_BLOCK_THRESHOLD=5
AUTO_IP_BLOCK_WINDOW_SECONDS=300

LOG_LEVEL=INFO
