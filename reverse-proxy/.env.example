LISTEN_ADDR=:8080
BACKEND_URL=http://localhost:9000
CONTROL_PLANE_URL=http://localhost:8000
CONTROL_PLANE_VALIDATE_PATH=/api/v1/api-keys/validate
CONTROL_PLANE_POLICY_PATH=/api/v1/internal/proxy-config
