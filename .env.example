# Copy to .env and generate unique values. Never commit the populated file.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
JWT_CONFIG_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Aegis Administrator

# Optional host-port overrides.
POSTGRES_PORT=5432
REDIS_PORT=6379
CONTROL_PLANE_PORT=8000
PROXY_PORT=8080
DASHBOARD_PORT=3000
UPSTREAM_PORT=9000

# Internal policy-stream tuning.
GRPC_SYNC_INTERVAL_SECONDS=2
GRPC_RECONNECT_DELAY=1s
AUTO_IP_BLOCK_ENABLED=true
AUTO_IP_BLOCK_THRESHOLD=5
AUTO_IP_BLOCK_WINDOW_SECONDS=300
